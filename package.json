    "format": "prettier --write ."
  },
  "devDependencies": {
    "@rocicorp/prettier-config": "^0.4.0",
    "prettier": "^3.8.0",
    "typescript": "~5.9.3"
  },
  "prettier": "@rocicorp/prettier-config"
}
